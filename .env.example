# Copy to .env and fill in. Never commit .env (it is gitignored).
# Names only here - real values belong in .env locally, or in platform secrets when deployed.

# Optional. Without it the app still runs: saved reports, triage and reconciliation work,
# and only the cached example questions are answerable in "Ask".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

ERP_DB_PATH=./data/erp.db
APP_DB_PATH=./data/app.db
QUERY_ROW_LIMIT=500

# The demo's fixed "today" (the seed data is generated relative to it).
AS_OF=2026-09-30
PORT=8787

# Optional, used only by the scheduled digest (GitHub Actions secret in CI).
SLACK_WEBHOOK_URL=
